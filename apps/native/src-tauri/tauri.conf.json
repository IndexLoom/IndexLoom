{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IndexLoom",
  "version": "0.3.0",
  "identifier": "org.indexloom.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": { "minimumSystemVersion": "15.0" }
  }
}
