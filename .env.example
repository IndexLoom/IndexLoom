INDEXLOOM_BIND=0.0.0.0:8080
INDEXLOOM_DATABASE_URL=sqlite:///data/indexloom.db?mode=rwc
INDEXLOOM_WEB_ROOT=/app/web
# Generate independently with: openssl rand -hex 32
INDEXLOOM_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
# Generate independently with: openssl rand -base64 32
INDEXLOOM_MASTER_KEY=replace-with-standard-base64-encoded-32-byte-key
# Optional local Indexers checkout. When empty, the verified GitHub archive is used.
INDEXLOOM_CATALOG_DIR=
INDEXLOOM_CATALOG_ARCHIVE_URL=https://github.com/IndexLoom/Indexers/archive/refs/heads/main.tar.gz
INDEXLOOM_CATALOG_SYNC_SECONDS=21600
RUST_LOG=indexloom=info,tower_http=info
