# Runtime: autonomous (default) executes SQLite and indexing locally.
# External mode only redirects to another HTTPS IndexLoom installation.
# CLI equivalents:
# indexloom-server --mode autonomous
# indexloom-server --mode external --remote https://indexloom.example.com/
# In external mode the admin token, database and master key are not loaded.
INDEXLOOM_RUNTIME_MODE=autonomous
# INDEXLOOM_REMOTE_URL=https://indexloom.example.com/

INDEXLOOM_BIND=0.0.0.0:8080
INDEXLOOM_DATABASE_URL=sqlite:///data/indexloom.db?mode=rwc
INDEXLOOM_WEB_ROOT=/app/web
# Generate independently with: openssl rand -hex 32
# Compose mounts this value as /run/secrets/indexloom_admin_token.
INDEXLOOM_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
# Generate independently with: openssl rand -base64 32
# Compose mounts this value as /run/secrets/indexloom_master_key.
INDEXLOOM_MASTER_KEY=replace-with-standard-base64-encoded-32-byte-key
# Optional local Indexers checkout. When empty, the verified GitHub archive is used.
INDEXLOOM_CATALOG_DIR=
# Release manifest is polled every 6 hours; assets are downloaded only after a change.
INDEXLOOM_CATALOG_SOURCE_URL=https://github.com/IndexLoom/Indexers/releases/latest/download/manifest.json
INDEXLOOM_CATALOG_SYNC_SECONDS=21600
RUST_LOG=indexloom=info,tower_http=info

# Authentication: token (compatible default), local, oidc, hybrid, disabled.
# Disabled auth is dangerous and requires INDEXLOOM_ALLOW_UNSAFE_NO_AUTH=true.
INDEXLOOM_AUTH_MODE=token
INDEXLOOM_ALLOW_UNSAFE_NO_AUTH=false
# SMTP is separately optional; account recovery requires mail to be enabled.
INDEXLOOM_MAIL_MODE=disabled
INDEXLOOM_REQUIRE_VERIFIED_EMAIL=false
# Public HTTPS origin for email verification and reset links.
# INDEXLOOM_PUBLIC_URL=https://indexloom.example.com
# OIDC requires an HTTPS issuer, client ID, exact redirect URL and email allowlist.
# INDEXLOOM_OIDC_ISSUER=https://id.example.com
# INDEXLOOM_OIDC_CLIENT_ID=indexloom
# INDEXLOOM_OIDC_CLIENT_SECRET=
# INDEXLOOM_OIDC_CLIENT_SECRET_FILE=/run/secrets/indexloom_oidc_client_secret
# INDEXLOOM_OIDC_ALLOWED_EMAILS=admin@example.org
# INDEXLOOM_OIDC_OWNER_EMAIL=admin@example.org
# INDEXLOOM_OIDC_REDIRECT_URI=https://indexloom.example.com/
# STARTTLS on 587 (default), implicit TLS on 465; no plaintext SMTP transport.
# INDEXLOOM_SMTP_HOST=smtp.example.org
# INDEXLOOM_SMTP_PORT=587
# INDEXLOOM_SMTP_FROM=IndexLoom <indexloom@example.org>
# INDEXLOOM_SMTP_USERNAME=indexloom@example.org
# INDEXLOOM_SMTP_PASSWORD=
# INDEXLOOM_SMTP_PASSWORD_FILE=/run/secrets/indexloom_smtp_password

# Experimental Torznab/RSS bridge; disabled unless a separate random API key is set.
# Generate: openssl rand -hex 32; never reuse INDEXLOOM_ADMIN_TOKEN.
# Torznab clients typically put this key in the query string, so use HTTPS
# and configure reverse-proxy access logs to redact query parameters.
# INDEXLOOM_TORZNAB_API_KEY=
